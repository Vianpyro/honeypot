# Template for the `.env` that compose.yml reads. COPY IT, do not rename it --
# the real file is git-ignored, 0600, and on the deployed host it is rendered by
# Ansible from the vault (VHome: roles/honeypot).
#
# NO REAL VALUE BELONGS IN THIS FILE. Everything below is a placeholder.

# --- PostgreSQL ---------------------------------------------------------
# Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=replace-me
POSTGRES_USER=honeypot
POSTGRES_DB=honeypot
POSTGRES_IMAGE=postgres:18

# --- Ingest authentication ----------------------------------------------
# Comma-separated key-id:secret pairs, the secret base64url WITHOUT padding and
# at least 32 bytes. The Worker sends the key id in X-Honeypot-Key-Id, so a
# rotation is: add a second pair here, deploy, switch the Worker, drop the old
# pair on the next deploy.
#
# Generate a secret:  openssl rand 32 | basenc --base64url | tr -d '='
HONEYPOT_HMAC_KEYS=v1:replace-me-with-43-base64url-characters

# --- Tunables -----------------------------------------------------------
HONEYPOT_RETENTION_DAYS=100
HONEYPOT_DB_MAX_CONNECTIONS=16
RUST_LOG=honeypot_api=info,tower_http=warn
TZ=America/Montreal

# --- AbuseIPDB reporter -------------------------------------------------
# Without a key the reporter starts, aggregates, and submits nothing -- so the
# stack is complete and inert until you decide otherwise.
#
# THE RATE LIMIT IS ABUSEIPDB'S: the Webmaster tier allows 10 bulk-report calls
# per day. Six hours is four. Do not lower it expecting more coverage: the same
# address is deduplicated for two days, so a shorter interval reports the same
# attackers no sooner and only spends quota.
# ABUSEIPDB_KEY=
HONEYPOT_REPORT_INTERVAL_HOURS=6
HONEYPOT_REPORT_WINDOW_HOURS=48
HONEYPOT_REPORT_MIN_EVENTS=5

# Your OWN network's AS numbers, comma-separated. Never reported. The
# well-known scanners (Cloudflare, Shodan, Censys, Google) are built in.
HONEYPOT_ALLOWLIST_ASNS=

# The reporter's own log filter. Separate from RUST_LOG above, which names the
# API's crate: one shared filter silences whichever crate it forgets.
REPORTER_LOG=honeypot_reporter=info

# --- Cloudflare tunnel (profile `tunnel`, not enabled by default) --------
# The token of a REMOTELY-MANAGED tunnel, from the Zero Trust dashboard. It is
# a credential: it never goes in this repository, only in the vault.
# TUNNEL_TOKEN=
